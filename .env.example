# Copy to .env and fill in your own keys (never commit .env)

# Required for Python CLI tools and agents
FIRECRAWL_API_KEY=your_firecrawl_key_here
CLAUDE_API_KEY=sk-ant-api...

# Optional: override default output directory
# OUTPUT_DIR=./output

# Optional: job-analyzer-web (server-side only in production)
# CLAUDE_API_KEY is read by Next.js API routes when set
